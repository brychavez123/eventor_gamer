# Copiar este archivo como ".env" y cambiar TODOS los valores.
# El archivo .env no se entrega ni se sube a repositorios (contiene secretos).

MYSQL_ROOT_PASSWORD=cambiar-por-una-clave-larga-root
DB_APP_PASSWORD=cambiar-por-una-clave-larga-app
# Mínimo 32 caracteres. Ejemplo para generarla en PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JWT_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres

# URL pública del sitio (se usa en los enlaces para compartir en redes sociales).
# En la VM: https://[IP-publica]/eventos
URL_PUBLICA=https://localhost/eventos

# "default" = aplicación corregida (la que se entrega).
# "inseguro" = solo para reproducir el escaneo ZAP "ANTES" de las correcciones.
PERFIL_SEGURIDAD=default

# Solo para el escaneo "ANTES": nginx-inseguro.conf. Entrega final: nginx.conf
NGINX_CONF=nginx.conf
